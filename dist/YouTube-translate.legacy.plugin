#!name = YouTube DeepSeek 双语字幕（实验版）
#!desc = 0.1.5；中文在上与居中待真机确认；与其他字幕重写插件互斥；密钥只存本地
#!system = iOS,iPadOS
#!date = 2026-10-23
# 旧版 Script 语法；翻译设置由手机本地 setup 脚本写入。
[Script]
http-response ^https:\/\/(?:www\.youtube\.com|m\.youtube\.com|youtube\.com|video\.google\.com)\/api\/timedtext(?:\?|$) script-path=yt-translate.js,requires-body=true,binary-body-mode=false,timeout=25,tag=YTSubs translate

[Mitm]
hostname = www.youtube.com, m.youtube.com, youtube.com, video.google.com
