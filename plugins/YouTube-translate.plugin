#!name = YouTube DeepSeek 双语字幕（实验版）
#!desc = 0.1.3；中文在上与居中待真机确认；与其他字幕重写插件互斥；密钥只存本地
#!system = iOS,iPadOS
#!date = 2026-10-23
#!loon_version = 3.5.1(983)
[Argument]
enabled = switch,false,type=boolean,tag=允许翻译,desc=先完成无 API 注入测试再开启
target = input,"zh-Hans",type=string,tag=目标语言
model = input,"deepseek-flash",type=string,tag=DeepSeek 模型
start_seconds = input,"0",type=string,tag=翻译起点秒数,desc=手动填写，不能自动读取播放进度
[Script]
response if ${url} ~= /^https:\/\/(?:www\.youtube\.com|m\.youtube\.com|youtube\.com|video\.google\.com)\/api\/timedtext(?:\?|$)/ then script("https://raw.githubusercontent.com/lpleasure/youtube-loon-deepseek/fix/subtitle-recovery-v013/dist/yt-translate.js", {${enabled}, ${target}, ${model}, ${start_seconds}}) with requires_body=true, binary_body_mode=false, timeout=25, tag="YTSubs translate"

[Mitm]
hostname = www.youtube.com, m.youtube.com, youtube.com, video.google.com
